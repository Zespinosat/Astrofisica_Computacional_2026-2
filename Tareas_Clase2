    "#se define la función a evaluar y su derivada\n",
    "def F(t):\n",
    "    return 100 + 15 * np.sin(np.pi * t / 6) + 3 * np.sin(np.pi * t / 2)\n",
    "\n",
    "def Fp(t):\n",
    "    return np.pi * (5 / 2) * np.cos(np.pi * t / 6) + np.pi * (3 / 2) * np.cos(np.pi * t /2)\n",
