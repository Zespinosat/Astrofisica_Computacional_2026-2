    "import numpy as np\n",
    "\n",
    "\n",
    "def vandermonde(x_datos):\n",
    "    x_datos = np.array(x_datos, dtype=float)\n",
    "    n = len(x_datos)\n",
    "    V = np.zeros((n, n), dtype=float)\n",
    "\n",
    "    for i in range(n):\n",
    "        for j in range(n):\n",
    "            V[i, j] = x_datos[i] ** j\n",
    "\n",
    "    return V\n",
    "\n",
    "\n",
    "def gauss_solve(A, b):\n",
    "    A = np.array(A, dtype=float)\n",
    "    b = np.array(b, dtype=float).reshape(-1, 1)\n",
    "\n",
    "    n = len(b)\n",
    "    # Matriz aumentada [A | b] de n filas y n+1 columnas\n",
    "    M = np.hstack([A, b])\n",
    "\n",
    "    for k in range(n):\n",
    "        # Pivoteo parcial: fila con mayor valor absoluto en columna k\n",
    "        piv = k + np.argmax(np.abs(M[k:n, k]))\n",
    "\n",
    "        # Intercambio de filas\n",
    "        M[[k, piv]] = M[[piv, k]]\n",
    "\n",
    "        # Eliminación hacia adelante\n",
    "        for i in range(k + 1, n):\n",
    "            factor = M[i, k] / M[k, k]\n",
    "            for j in range(k, n + 1):\n",
    "                M[i, j] -= factor * M[k, j]\n",
    "\n",
    "    # Sustitución hacia atrás\n",
    "    x = np.zeros(n, dtype=float)\n",
    "    for i in range(n - 1, -1, -1):\n",
    "        suma = 0.0\n",
    "        for j in range(i + 1, n):\n",
    "            suma += M[i, j] * x[j]\n",
    "        x[i] = (M[i, n] - suma) / M[i, i]\n",
    "\n",
    "    return x\n",
    "\n",
    "\n",
    "def interp_directo(x_datos, y_datos, x_eval=-0.25):\n",
    "    V = vandermonde(x_datos)\n",
    "    a = gauss_solve(V, y_datos)  # Coeficientes del polinomio\n",
    "\n",
    "    resultado = 0.0\n",
    "    for j in range(len(a)):\n",
    "        resultado += a[j] * (x_eval**j)\n",
    "\n",
    "    return resultado\n",
    "\n",
    "\n",
    "#Carga de datos\n",
    "if __name__ == \"__main__\":\n",
    "    datos = np.load(\"data1.npy\")\n",
    "\n",
    "    t, flujo = datos[0], datos[1]\n",
    "    x_eval_val = -0.25\n",
    "    flujo_estimado = interp_directo(t, flujo, x_eval=x_eval_val)\n",
    "\n",
    "    print(f\"Flujo estimado en x_eval = {x_eval_val}: {flujo_estimado}\")"
   ]
