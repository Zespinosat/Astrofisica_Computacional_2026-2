    "def diff_backward(t):\n",
    "    return (F(t_0) - F(t_0 - h)) / h\n",
    "\n",
    "def diff_centered(t):\n",
    "    return (F(t_0 + h) - F(t_0 - h)) / (2 * h)\n",
    "\n",
    "def diff2_centered(t):\n",
    "    return (F(t_0 + h) - 2 * F(t_0) + F(t_0 - h))/ (h ** 2)\n",
    "\n",
    "#se hallan los valores solicitados\n",
