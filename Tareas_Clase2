    "#se importa numpy para la exponencial\n",
    "import numpy as np\n",
    "\n",
    "#se definen constantes\n",
    "L_0 = 5 * 10 ** 42\n",
    "Tau = 111.4\n",
    "\n",
    "#se define la función sin derivar, su derivada exacta y su segunda derivada exacta\n",
    "def L(t):\n",
    "    return L_0 * np.exp(-t/Tau)\n",
    "\n",
    "def Lp(t):\n",
    "    return (-1 * L_0 / Tau) * np.exp(-t/Tau)\n",
    "\n",
    "def Lp2(t):\n",
    "    return L_0/ (Tau ** 2) * np.exp(-t/Tau)\n",
    "\n",
    "#se evalúa en t=0\n",
    "Lp0 = Lp(0)\n",
    "print(\"La derivada exacta en t = 0 es \",Lp0)\n",
    "\n",
    "#se definen t_0 y h (delta t)\n",
    "t_0 = 64\n",
    "h = 2.0\n",
    "#se hallan las derivadas en t_0\n",
    "Lp64 = Lp(t_0)\n",
    "Lp2 = Lp2(t_0)\n",
    "\n",
    "print(\"La derivada exacta en t = 64 es \",Lp64)\n",
    "\n",
    "#se definen las diferenciales numéricas\n",
    "def diff_forward(t):\n",
    "    return (L(t_0 + h) - L(t_0)) / h\n",
    "\n",
    "def diff_backward(t):\n",
    "    return (L(t_0) - L(t_0 - h)) / h\n",
    "\n",
    "def diff_centered(t):\n",
    "    return (L(t_0 + h) - L(t_0 - h)) / (2 * h)\n",
    "\n",
    "def diff2_centered(t):\n",
    "    return (L(t_0 + h) - 2 * L(t_0) + L(t_0 - h))/ (h ** 2)\n",
    "\n",
    "#se calculan las derivadas\n",
    "d_forward = diff_forward(t_0)\n",
    "d_backward = diff_backward(t_0)\n",
    "d_centered = diff_centered(t_0)\n",
    "d2_centered = diff2_centered(t_0)\n",
    "\n",
    "print(\"La derivada hacía adelante es: \", d_forward)\n",
